RAILS_ENV=development
RAILS_MAX_THREADS=5

# Required in production on Heroku. Generate with: bin/rails secret
SECRET_KEY_BASE=

# Heroku Postgres sets DATABASE_URL automatically when the add-on is attached.
DATABASE_URL=

# Cloudinary add-on usually sets CLOUDINARY_URL automatically.
CLOUDINARY_URL=

# Alternative Cloudinary configuration when CLOUDINARY_URL is not used.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. Needed only when Stripe checkout is enabled.
# connect: SaaS platform mode using Stripe Connect.
# direct: installable single-company mode using this environment's Stripe account directly.
STRIPE_MODE=connect
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional override when wkhtmltopdf is installed in a non-standard path.
WKHTMLTOPDF_PATH=

# Optional. Keep false/blank until SMTP is configured for email OTP login.
EMAIL_OTP_LOGIN_ENABLED=false
