RAILS_ENV=development
RAILS_MAX_THREADS=5

# Required in production on Heroku. Generate with: bin/rails secret
SECRET_KEY_BASE=

# Heroku Postgres sets DATABASE_URL automatically when the add-on is attached.
DATABASE_URL=

# Cloudinary add-on usually sets CLOUDINARY_URL automatically.
CLOUDINARY_URL=

# Alternative Cloudinary configuration when CLOUDINARY_URL is not used.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. Needed only when Stripe checkout is enabled.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional override when wkhtmltopdf is installed in a non-standard path.
WKHTMLTOPDF_PATH=
