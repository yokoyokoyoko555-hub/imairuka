RAILS_MAX_THREADS=5
SECRET_KEY_BASE=replace-this-with-a-long-random-secret-before-production-use

# Installable mode: this environment uses its own Stripe account directly.
STRIPE_MODE=direct
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. Set if you publish this install behind a domain.
APP_HOSTS=
