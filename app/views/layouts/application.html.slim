doctype html
html data-turbo="false"
  head
    title 案件管理システム イマイルカ
    meta[name="viewport" content="width=device-width,initial-scale=1"]
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_importmap_tags
    / jQuery
    script[src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"]
    / Bootstrap CSS
    link[href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"]
    / Bootstrap Icons
    link[href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"]
    / Chart.js
    script[src="https://cdn.jsdelivr.net/npm/chart.js"]
    / Custom CSS
    = stylesheet_link_tag "custom", "data-turbo-track": "reload"

  body
    / ナビゲーションバー
    nav.navbar.navbar-expand-lg.navbar-dark.bg-primary.fixed-top
      .container-fluid
        = link_to root_path, class: "navbar-brand d-flex align-items-center" do
          = image_tag "logo.png", alt: "ロゴ", height: "30", class: "me-2"
          span.d-none.d-sm-inline 案件管理システム
        button.navbar-toggler[type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation"]
          span.navbar-toggler-icon
        #navbarNav.collapse.navbar-collapse
          ul.navbar-nav.me-auto
            li.nav-item
              = link_to orders_path, class: "nav-link #{controller_name == 'orders' && !['billing', 'show_billing', 'edit_payment', 'update_payment'].include?(action_name) ? 'active' : ''}" do
                i.bi.bi-cart.me-2
                | 案件一覧
            li.nav-item
              = link_to project_managements_path, class: "nav-link #{controller_name == 'project_managements' ? 'active' : ''}" do
                i.bi.bi-kanban.me-1
                | 案件管理
            li.nav-item
              = link_to customers_path, class: "nav-link #{controller_name == 'customers' ? 'active' : ''}" do
                i.bi.bi-people.me-1
                | 顧客管理
            li.nav-item
              = link_to products_path, class: "nav-link #{controller_name == 'products' ? 'active' : ''}" do
                i.bi.bi-box-seam.me-1
                | 商品管理
          ul.navbar-nav
            li.nav-item.dropdown
              a.nav-link.dropdown-toggle[href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"]
                i.bi.bi-person-circle.me-1
                | 管理者
              ul.dropdown-menu.dropdown-menu-end
                li
                  = link_to settings_path, class: "dropdown-item" do
                    i.bi.bi-gear.me-1
                    | 設定
                li
                  hr.dropdown-divider
                li
                  = button_to logout_path, method: :delete, class: "dropdown-item", form: { style: "display:inline; background:none; border:none; padding:0; margin:0;" } do
                    i.bi.bi-box-arrow-right.me-1
                    | ログアウト

    / メインコンテンツ
    .wrapper
      / サイドバー
      aside.sidebar
        .sidebar-header
          ul.nav.flex-column
            li.nav-item
              = link_to root_path, class: "nav-link #{current_page?(root_path) ? 'active' : ''}" do
                i.bi.bi-speedometer2.me-2
                | ダッシュボード

            li.nav-item.mt-3
              small.text-white-50.ps-3 案件管理
            li.nav-item
              = link_to orders_path, class: "nav-link #{controller_name == 'orders' && !['billing', 'show_billing', 'edit_payment', 'update_payment'].include?(action_name) ? 'active' : ''}" do
                i.bi.bi-cart.me-2
                | 案件一覧
            li.nav-item
              = link_to project_managements_path, class: "nav-link #{controller_name == 'project_managements' ? 'active' : ''}" do
                i.bi.bi-kanban.me-2
                | 案件管理

            li.nav-item.mt-3
              small.text-white-50.ps-3 決済管理
            li.nav-item
              = link_to billing_orders_path, class: "nav-link #{controller_name == 'orders' && ['billing', 'show_billing', 'edit_payment', 'update_payment'].include?(action_name) ? 'active' : ''}" do
                i.bi.bi-receipt.me-2
                | 請求管理
            li.nav-item
              = link_to payment_histories_path, class: "nav-link #{controller_name == 'payment_histories' ? 'active' : ''}" do
                i.bi.bi-credit-card.me-2
                | 決済履歴

            li.nav-item.mt-3
              small.text-white-50.ps-3 文書管理
            li.nav-item
              = link_to quotations_path, class: "nav-link #{controller_name == 'quotations' ? 'active' : ''}" do
                i.bi.bi-file-earmark-text.me-2
                | 見積書管理
            li.nav-item
              = link_to delivery_notes_path, class: "nav-link #{controller_name == 'delivery_notes' ? 'active' : ''}" do
                i.bi.bi-file-earmark-check.me-2
                | 納品書管理
            li.nav-item
              = link_to invoices_path, class: "nav-link #{controller_name == 'invoices' ? 'active' : ''}" do
                i.bi.bi-file-earmark-text.me-2
                | 請求書管理
            li.nav-item
              = link_to receipts_path, class: "nav-link #{controller_name == 'receipts' ? 'active' : ''}" do
                i.bi.bi-receipt.me-2
                | 領収書管理

            li.nav-item.mt-3
              small.text-white-50.ps-3 マスタ管理
            li.nav-item
              = link_to customers_path, class: "nav-link #{controller_name == 'customers' ? 'active' : ''}" do
                i.bi.bi-people.me-2
                | 顧客管理
            li.nav-item
              = link_to products_path, class: "nav-link #{controller_name == 'products' ? 'active' : ''}" do
                i.bi.bi-box-seam.me-2
                | 商品管理

            li.nav-item.mt-3
              small.text-white-50.ps-3 システム
            - if current_user&.can_manage_users?
              li.nav-item
                = link_to account_users_path, class: "nav-link #{controller_path.start_with?('account/') ? 'active' : ''}" do
                  i.bi.bi-person-plus.me-2
                  | ユーザー管理
            li.nav-item
              = link_to settings_path, class: "nav-link #{controller_name == 'settings' ? 'active' : ''}" do
                i.bi.bi-gear.me-2
                | 設定

      / ページコンテンツ
      #content
        / フラッシュメッセージ
        / Content Row
        = render 'shared/flash_messages'
        = yield
      / /.container-fluid
    / End of Main Content

    / Bootstrap Bundle with Popper
    script[src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" data-turbo-track="reload"]
    / Custom JavaScript
    = javascript_include_tag "custom", "data-turbo-track": "reload" 
