doctype html
html data-turbo="false"
  head
    title Imairuka 運営管理
    meta[name="viewport" content="width=device-width,initial-scale=1"]
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_importmap_tags
    script[src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"]
    link[href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"]
    link[href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"]
    = stylesheet_link_tag "custom", "data-turbo-track": "reload"

  body.admin-layout
    nav.navbar.navbar-expand-lg.navbar-light.admin-navbar.fixed-top
      .container-fluid
        = link_to admin_companies_path, class: "navbar-brand d-flex align-items-center" do
          = image_tag "logo.png", alt: "Imairuka", height: "30", class: "me-2"
          span Imairuka 運営管理
        ul.navbar-nav.ms-auto
          li.nav-item
            = link_to root_path, class: "nav-link" do
              i.bi.bi-box-arrow-up-right.me-1
              | 利用者画面
          li.nav-item
            = button_to logout_path, method: :delete, class: "nav-link btn btn-link", form: { class: "d-inline" } do
              i.bi.bi-box-arrow-right.me-1
              | ログアウト

    .wrapper
      aside.sidebar
        .sidebar-header
          ul.nav.flex-column
            li.nav-item
              = link_to admin_companies_path, class: "nav-link #{controller_path == 'admin/companies' ? 'active' : ''}" do
                i.bi.bi-building.me-2
                | 契約管理
            li.nav-item
              = link_to admin_vendors_path, class: "nav-link #{controller_path == 'admin/vendors' ? 'active' : ''}" do
                i.bi.bi-diagram-3.me-2
                | ベンダー管理
            li.nav-item.mt-3
              small.text-white-50.ps-3 契約操作
            li.nav-item
              = link_to new_admin_company_path, class: "nav-link #{current_page?(new_admin_company_path) ? 'active' : ''}" do
                i.bi.bi-plus-circle.me-2
                | 新しい契約を追加

      #content
        = render "shared/flash_messages"
        = yield

    script[src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" data-turbo-track="reload"]
    = javascript_include_tag "custom", "data-turbo-track": "reload"
