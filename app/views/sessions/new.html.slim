= form_with url: login_path, method: :post, local: true do |f|
  .mb-3
    = f.label :email, 'メールアドレス', class: 'form-label'
    .input-group
      span.input-group-text
        i.bi.bi-envelope
      = f.email_field :email, class: 'form-control', placeholder: 'example@example.com', required: true
  .mb-4
    = f.label :password, 'パスワード', class: 'form-label'
    .input-group
      span.input-group-text
        i.bi.bi-key
      = f.password_field :password, class: 'form-control', placeholder: 'パスワードを入力', required: true
  .mb-3.form-check
    = f.check_box :remember_me, class: 'form-check-input'
    = f.label :remember_me, 'ログイン状態を保持', class: 'form-check-label'
  .d-grid.gap-2
    = f.submit 'ログイン', class: 'btn btn-primary btn-lg' 