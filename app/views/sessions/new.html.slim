= form_with url: login_path, method: :post, local: true do |f|
  .mb-3
    = f.label :email, "ログインID（登録メールアドレス）", class: "form-label"
    .input-group
      span.input-group-text
        i.bi.bi-envelope
      = f.email_field :email, class: "form-control", placeholder: "example@example.com", required: true, autocomplete: "email"
  .mb-4
    = f.label :password, "パスワード", class: "form-label"
    .input-group
      span.input-group-text
        i.bi.bi-key
      = f.password_field :password, class: "form-control", placeholder: "パスワードを入力", required: true, autocomplete: "current-password"
  .d-grid.gap-2
    = f.submit "認証コードを送信", class: "btn btn-primary btn-lg"

.text-center.mt-4
  = link_to "利用申込はこちら", new_signup_path, class: "text-decoration-none"
