.container-fluid
  .row.mb-4
    .col
      h1.h3.mb-3.text-gray-800
        i.bi.bi-file-earmark-text.me-2
        | 見積書詳細
      .d-flex.justify-content-end.gap-2
        = link_to quotations_path, class: 'btn btn-outline-secondary' do
          i.bi.bi-arrow-left.me-1
          | 一覧に戻る
        = link_to edit_quotation_path(@quotation), class: 'btn btn-outline-primary write-action' do
          i.bi.bi-pencil.me-1
          | 編集

  .row
    .col-lg-8
      / 基本情報
      .card.shadow.mb-4
        .card-header.py-3
          h6.m-0.font-weight-bold.text-primary
            i.bi.bi-info-circle.me-2
            | 基本情報
        .card-body
          .row.mb-3
            .col-md-6
              label.form-label.text-muted 見積書番号
              p = @quotation.quotation_number
            .col-md-6
              label.form-label.text-muted 作成日
              p = format_date(@quotation.quotation_date)
          .row.mb-3
            .col-md-6
              label.form-label.text-muted 顧客名
              p = @quotation.customer_name
            .col-md-6
              label.form-label.text-muted 担当者
              p = @quotation.staff_name
          .row.mb-3
            .col-md-12
              label.form-label.text-muted 顧客住所
              p = @quotation.customer_address.presence || "未入力"
          .row.mb-3
            .col-md-12
              label.form-label.text-muted 件名
              p = @quotation.subject.presence || "未入力"
          .row.mb-3
            .col-md-6
              label.form-label.text-muted ステータス
              p
                span.badge class="bg-#{@quotation.status_color}"
                  = @quotation.status_text
            .col-md-6
              label.form-label.text-muted 合計金額
              p = number_to_currency(@quotation.total_amount_with_tax, unit: "¥", precision: 0)
          .row.mb-3
            .col-md-12
              label.form-label.text-muted 備考
              p = @quotation.notes.presence || "なし"

      / 見積商品
      .card.shadow.mb-4
        .card-header.py-3
          h6.m-0.font-weight-bold.text-primary
            i.bi.bi-cart.me-2
            | 見積商品
        .card-body
          .table-responsive
            table.table.table-bordered
              thead.table-light
                tr
                  th 商品コード
                  th 商品名
                  th.text-end 単価
                  th.text-end 数量
                  th.text-end 金額
                  th 税率
              tbody
                - @quotation.quotation_items.each do |item|
                  tr
                    td = item.product_code
                    td = item.product_name
                    td.text-end = number_to_currency(item.unit_price, unit: "¥", precision: 0)
                    td.text-end = item.quantity
                    td.text-end = number_to_currency(item.amount, unit: "¥", precision: 0)
                    td = item.tax_rate_label
              tfoot
                tr
                  td.text-end[colspan="5"] 合計金額
                  td.text-end = number_to_currency(@quotation.total_amount_with_tax, unit: "¥", precision: 0)

      / 見積情報
      .card.shadow.mb-4
        .card-header.py-3
          h6.m-0.font-weight-bold.text-primary
            i.bi.bi-calendar.me-2
            | 見積情報
        .card-body
          .row.mb-3
            .col-md-6
              label.form-label.text-muted 有効期限
              p = format_date(@quotation.valid_until) || "未設定"
            .col-md-6
              label.form-label.text-muted 最終更新日
              p = format_datetime(@quotation.updated_at)

      / 履歴
      .card.shadow.mb-4
        .card-header.py-3
          h6.m-0.font-weight-bold.text-primary
            i.bi.bi-clock-history.me-2
            | 処理履歴
        .card-body
          .timeline
            - @quotation.quotation_histories.order(created_at: :asc).each do |history|
              .timeline-item.mb-3
                .timeline-marker
                .timeline-content
                  .d-flex.justify-content-between
                    strong = history.description
                    small.text-muted = history.created_at.strftime('%Y/%m/%d %H:%M')

    .col-lg-4
      / 操作
      .card.shadow.mb-4
        .card-header.py-3
          h6.m-0.font-weight-bold.text-primary
            i.bi.bi-gear.me-2
            | 操作
        .card-body
          .d-grid.gap-2
            = link_to print_quotation_path(@quotation), class: 'btn btn-outline-info', target: '_blank' do
              i.bi.bi-printer.me-1
              | プレビュー
            = link_to download_pdf_quotation_path(@quotation), class: 'btn btn-outline-success' do
              i.bi.bi-download.me-1
              | PDFダウンロード
            = link_to quotation_path(@quotation), class: 'btn btn-outline-danger write-action', data: { delete_action: true, confirm: 'この見積書を削除してもよろしいですか？\nこの操作は取り消せません。' } do
              i.bi.bi-trash.me-1
              | 削除

      / 他の書類を作成
      .card.shadow
        .card-header.py-3
          h6.m-0.font-weight-bold.text-primary
            i.bi.bi-plus-circle.me-2
            | 他の書類を作成
        .card-body
          p.text-muted.small.mb-3 この見積書の基本情報と商品情報を基に他の書類を作成できます
          .row.g-3
            .col-12
              = link_to copy_to_delivery_note_quotation_path(@quotation), class: "card text-decoration-none h-100 border-primary write-action" do
                .card-body.text-center.py-4
                  i.bi.bi-file-earmark-check.text-primary.fs-1.mb-3
                  h6.card-title.text-primary 納品書を作成
                  p.card-text.small.text-muted 見積書の基本情報と商品情報を基に納品書を作成します
            .col-12
              = link_to copy_to_invoice_quotation_path(@quotation), class: "card text-decoration-none h-100 border-success write-action" do
                .card-body.text-center.py-4
                  i.bi.bi-file-earmark-text.text-success.fs-1.mb-3
                  h6.card-title.text-success 請求書を作成
                  p.card-text.small.text-muted 見積書の基本情報と商品情報を基に請求書を作成します
            .col-12
              = link_to copy_to_receipt_quotation_path(@quotation), class: "card text-decoration-none h-100 border-info write-action" do
                .card-body.text-center.py-4
                  i.bi.bi-receipt.text-info.fs-1.mb-3
                  h6.card-title.text-info 領収書を作成
                  p.card-text.small.text-muted 見積書の基本情報と商品情報を基に領収書を作成します

= javascript_include_tag "delete_actions"
