.container-fluid
  .d-flex.justify-content-between.align-items-center.mb-4
    div
      h1.h3.mb-1 契約条件を編集
      .text-muted = @company.name
    = link_to "詳細へ戻る", admin_company_path(@company), class: "btn btn-outline-secondary"

  = form_with model: @company, url: admin_company_path(@company), method: :patch, local: true do |f|
    - if @company.errors.any?
      .alert.alert-danger
        ul.mb-0
          - @company.errors.full_messages.each do |message|
            li = message

    .row.g-3
      .col-lg-6
        .card.shadow-sm.h-100
          .card-header
            strong 利用会社情報
          .card-body
            .mb-3
              = f.label :name, "会社名", class: "form-label"
              = f.text_field :name, class: "form-control", required: true
            .mb-3
              = f.label :tenant_slug, "テナントID", class: "form-label"
              = f.text_field :tenant_slug, class: "form-control", required: true
            .mb-3
              = f.label :invoice_number, "登録番号", class: "form-label"
              = f.text_field :invoice_number, class: "form-control", required: true
            .row
              .col-md-6.mb-3
                = f.label :postal_code, "郵便番号", class: "form-label"
                = f.text_field :postal_code, class: "form-control", required: true
              .col-md-6.mb-3
                = f.label :phone, "電話番号", class: "form-label"
                = f.text_field :phone, class: "form-control", required: true
            .mb-3
              = f.label :address, "住所", class: "form-label"
              = f.text_area :address, class: "form-control", rows: 3, required: true
            .mb-3
              = f.label :email, "会社メール", class: "form-label"
              = f.email_field :email, class: "form-control", required: true
            .row
              .col-md-6.mb-3
                = f.label :representative, "代表者", class: "form-label"
                = f.text_field :representative, class: "form-control", required: true
              .col-md-6.mb-3
                = f.label :business_type, "業種", class: "form-label"
                = f.text_field :business_type, class: "form-control", required: true

      .col-lg-6
        .card.shadow-sm.h-100
          .card-header
            strong 契約・請求条件
          .card-body
            .row
              .col-md-6.mb-3
                = f.label :sales_channel, "販売経路", class: "form-label"
                = f.select :sales_channel, [["直販", "direct"], ["ベンダー経由", "vendor"]], {}, class: "form-select"
              .col-md-6.mb-3
                = f.label :vendor_id, "ベンダー", class: "form-label"
                = f.collection_select :vendor_id, @vendors, :id, :display_name, { include_blank: "直販の場合は未選択" }, class: "form-select"
            .row
              .col-md-6.mb-3
                = f.label :contract_status, "契約状態", class: "form-label"
                = f.select :contract_status, Company.contract_statuses.keys.map { |status| [Company.new(contract_status: status).contract_status_label, status] }, {}, class: "form-select"
              .col-md-6.mb-3
                = f.label :billing_status, "請求状態", class: "form-label"
                = f.select :billing_status, Company.billing_statuses.keys.map { |status| [Company.new(billing_status: status).billing_status_label, status] }, {}, class: "form-select"
            .row
              .col-md-6.mb-3
                = f.label :contract_amount, "契約金額", class: "form-label"
                = f.number_field :contract_amount, class: "form-control", min: 0, step: 1
              .col-md-6.mb-3
                = f.label :contract_months, "契約期間（月）", class: "form-label"
                = f.number_field :contract_months, class: "form-control", min: 1, step: 1
            .row
              .col-md-6.mb-3
                = f.label :contract_starts_on, "契約開始日", class: "form-label"
                = f.date_field :contract_starts_on, class: "form-control"
              .col-md-6.mb-3
                = f.label :contract_ends_on, "契約終了日", class: "form-label"
                = f.date_field :contract_ends_on, class: "form-control"
            .row
              .col-md-6.mb-3
                = f.label :payment_due_on, "入金予定日", class: "form-label"
                = f.date_field :payment_due_on, class: "form-control"
              .col-md-6.mb-3
                = f.label :paid_on, "入金日", class: "form-label"
                = f.date_field :paid_on, class: "form-control"
            .row
              .col-md-6.mb-3
                = f.label :internal_invoice_number, "請求番号", class: "form-label"
                = f.text_field :internal_invoice_number, class: "form-control"
              .col-md-6.mb-3
                = f.label :additional_user_slots, "追加アカウント枠", class: "form-label"
                = f.number_field :additional_user_slots, class: "form-control", min: 0, step: 1
            .mb-3
              = f.label :contract_notes, "契約メモ", class: "form-label"
              = f.text_area :contract_notes, class: "form-control", rows: 4
            .border.rounded.p-3.bg-light
              .fw-bold = @company.plan_label
              .small.text-muted = @company.plan_description

    .mt-4
      = f.submit "契約情報を保存", class: "btn btn-primary"
      = link_to "キャンセル", admin_company_path(@company), class: "btn btn-outline-secondary ms-2"
