.container-fluid
  .d-flex.justify-content-between.align-items-center.mb-4
    div
      h1.h3.mb-1 = @company.name
      .text-muted 契約詳細
    = link_to "一覧へ戻る", admin_companies_path, class: "btn btn-outline-secondary"

  .card.shadow-sm.mb-3
    .card-header
      strong 運用ステップ
    .card-body
      .row.g-3.align-items-stretch
        .col-md-4
          .border.rounded.p-3.h-100 class=(@company.pending_review? ? "border-warning bg-warning-subtle" : "bg-light")
            .fw-bold 1. 申込受付
            .small.text-muted.mb-3 内容を確認し、請求書を発行します。
            - if @company.pending_review?
              = button_to "請求書発行済みにする", approve_admin_company_path(@company), method: :patch, class: "btn btn-primary btn-sm"
            - else
              span.badge.bg-secondary 完了
        .col-md-4
          .border.rounded.p-3.h-100 class=(@company.billing_invoiced? ? "border-info bg-info-subtle" : "bg-light")
            .fw-bold 2. 入金確認
            .small.text-muted.mb-3 銀行振込の入金確認後、利用開始します。
            - if @company.billing_invoiced?
              = button_to "入金済みにして利用開始", mark_paid_admin_company_path(@company), method: :patch, class: "btn btn-success btn-sm"
            - elsif @company.billing_paid?
              span.badge.bg-secondary 完了
            - else
              span.badge.bg-secondary 待機中
        .col-md-4
          .border.rounded.p-3.h-100 class=(@company.active? ? "border-success bg-success-subtle" : "bg-light")
            .fw-bold 3. 招待URL発行
            .small.text-muted.mb-3 入金済みにすると初期管理者の招待URLを発行します。
            - if @company.active?
              span.badge.bg-success 利用開始済み
            - else
              span.badge.bg-secondary 未開始

  - if flash[:invitation_url].present?
    .alert.alert-info
      .fw-bold.mb-2 初期管理者 招待URL
      .input-group
        input#invitation-url.form-control type="text" readonly="readonly" value=flash[:invitation_url]
        button.btn.btn-outline-primary type="button" onclick="navigator.clipboard.writeText(document.getElementById('invitation-url').value); this.textContent='コピー済み';" コピー
      .small.text-muted.mt-2 URLはこの画面で控えてください。必要な場合は未承諾の招待から再発行できます。

  .row.g-3
    .col-lg-8
      .card.shadow-sm.h-100
        .card-header
          strong 契約情報
        .card-body
          .row.g-3
            .col-md-6
              dl.row.mb-0
                dt.col-sm-5 契約状態
                dd.col-sm-7
                  span.badge class=@company.contract_status_badge_class
                    = @company.contract_status_label
                dt.col-sm-5 販売経路
                dd.col-sm-7 = @company.sales_channel_label
                dt.col-sm-5 ベンダー
                dd.col-sm-7
                  - if @company.vendor
                    = link_to @company.vendor.name, admin_vendor_path(@company.vendor)
                  - else
                    | -
                dt.col-sm-5 請求先
                dd.col-sm-7 = @company.billing_payer_label
                dt.col-sm-5 プラン
                dd.col-sm-7
                  .fw-semibold = @company.plan_label
                  .small.text-muted = @company.plan_description
            .col-md-6
              dl.row.mb-0
                dt.col-sm-5 契約金額
                dd.col-sm-7 = @company.contract_amount_label
                dt.col-sm-5 契約期間
                dd.col-sm-7 = @company.contract_period_label
                dt.col-sm-5 開始日
                dd.col-sm-7 = @company.contract_starts_on || "-"
                dt.col-sm-5 終了日
                dd.col-sm-7 = @company.contract_ends_on || "-"
                dt.col-sm-5 停止日時
                dd.col-sm-7 = @company.suspended_at ? l(@company.suspended_at, format: :short) : "-"

    .col-lg-4
      .card.shadow-sm.h-100
        .card-header
          strong 契約操作
        .card-body
          .d-grid.gap-2
            - if @company.billing_invoiced?
              = button_to "入金済みにして利用開始", mark_paid_admin_company_path(@company), method: :patch, class: "btn btn-success"
            - if @company.contract_active?
              = button_to "契約を停止", suspend_contract_admin_company_path(@company), method: :patch, class: "btn btn-outline-warning", data: { turbo_confirm: "この契約を停止します。利用者はログインできなくなります。よろしいですか？" }
            - if @company.suspended?
              = button_to "契約を再開", resume_contract_admin_company_path(@company), method: :patch, class: "btn btn-primary"
            - unless @company.canceled?
              = button_to "契約を解約", cancel_contract_admin_company_path(@company), method: :patch, class: "btn btn-outline-danger", data: { turbo_confirm: "この契約を解約状態にします。よろしいですか？" }
            - if @company.pending_review?
              .text-muted.small 請求書発行前の契約候補です。
            - elsif @company.canceled?
              .text-muted.small 解約済みの契約です。再開が必要な場合は新しい契約として扱います。

  .row.g-3.mt-0
    .col-md-6
      .card.shadow-sm.h-100
        .card-header
          strong 請求・銀行振込
        .card-body
          dl.row.mb-0
            dt.col-sm-5 請求状態
            dd.col-sm-7
              span.badge class=@company.billing_status_badge_class
                = @company.billing_status_label
            dt.col-sm-5 請求番号
            dd.col-sm-7 = @company.internal_invoice_number.presence || "-"
            dt.col-sm-5 請求書発行日
            dd.col-sm-7 = @company.invoiced_on || "-"
            dt.col-sm-5 入金予定日
            dd.col-sm-7 = @company.payment_due_on || "-"
            dt.col-sm-5 入金日
            dd.col-sm-7 = @company.paid_on || "-"
            dt.col-sm-5 メモ
            dd.col-sm-7 = simple_format(@company.contract_notes.presence || "-")

    .col-md-6
      .card.shadow-sm.h-100
        .card-header
          strong 申込情報
        .card-body
          dl.row.mb-0
            dt.col-sm-5 代表者
            dd.col-sm-7 = @company.representative
            dt.col-sm-5 メール
            dd.col-sm-7 = @company.email
            dt.col-sm-5 電話番号
            dd.col-sm-7 = @company.phone
            dt.col-sm-5 登録番号
            dd.col-sm-7 = @company.invoice_number
            dt.col-sm-5 業種
            dd.col-sm-7 = @company.business_type
            dt.col-sm-5 住所
            dd.col-sm-7 = "〒#{@company.postal_code} #{@company.address}"

  .row.g-3.mt-0
    .col-md-6
      .card.shadow-sm.h-100
        .card-header
          strong 利用状態
        .card-body
          dl.row.mb-0
            dt.col-sm-5 ユーザー枠
            dd.col-sm-7 = "#{@company.user_slots_used} / #{@company.user_limit_label}"
            dt.col-sm-5 標準枠
            dd.col-sm-7 = "#{@company.included_user_limit}名"
            dt.col-sm-5 追加枠
            dd.col-sm-7 = "#{@company.additional_user_slots.to_i}名"
            dt.col-sm-5 招待可能
            dd.col-sm-7 = @company.remaining_user_slots.nil? ? "無制限" : "#{@company.remaining_user_slots}名"
            dt.col-sm-5 案件数
            dd.col-sm-7 = @orders_count
            dt.col-sm-5 決済履歴数
            dd.col-sm-7 = @payments_count
          .alert class=(@can_invite_user ? "alert-success" : "alert-warning") class="mt-3 mb-0"
            = @company.user_limit_message
    .col-md-6
      .card.shadow-sm.h-100
        .card-header
          strong Stripe Connect
        .card-body
          .alert.alert-light.border
            | Stripeは利用会社が自社顧客から決済を受ける場合のみ使用します。SaaS利用料とベンダー卸料は請求書・銀行振込で管理します。
          dl.row.mb-0
            dt.col-sm-5 連携状態
            dd.col-sm-7 = @company.stripe_connect_status
            dt.col-sm-5 StripeアカウントID
            dd.col-sm-7 = @company.stripe_account_id.presence || "-"

  .card.shadow-sm.mt-3
    .card-header.d-flex.justify-content-between.align-items-center
      strong ユーザー
      - if @can_invite_user
        = link_to "ユーザーを招待", new_admin_company_user_invitation_path(@company), class: "btn btn-sm btn-primary"
      - else
        button.btn.btn-sm.btn-secondary type="button" disabled="disabled" ユーザーを招待
    .card-body.p-0
      .table-responsive
        table.table.table-hover.mb-0
          thead.table-light
            tr
              th メール
              th 名前
              th 権限
              th 状態
              th 最終ログイン
          tbody
            - if @users.any?
              - @users.each do |user|
                tr
                  td = user.email
                  td = user.name.presence || "-"
                  td = user.role_label
                  td = user.active? ? "有効" : "停止"
                  td = user.last_login_at ? l(user.last_login_at, format: :short) : "-"
            - else
              tr
                td.text-muted colspan="5" まだユーザーは作成されていません

  .card.shadow-sm.mt-3
    .card-header
      strong 未承諾の招待
      span.badge.bg-secondary.ms-2 = @pending_invitations.size
    .card-body.p-0
      .table-responsive
        table.table.table-hover.mb-0
          thead.table-light
            tr
              th メール
              th 名前
              th 権限
              th 期限
              th 招待者
          tbody
            - if @pending_invitations.any?
              - @pending_invitations.each do |invitation|
                tr
                  td = invitation.email
                  td = invitation.name.presence || "-"
                  td = invitation.role_label
                  td = l(invitation.expires_at, format: :short)
                  td = invitation.invited_by&.display_name || "-"
            - else
              tr
                td.text-muted colspan="5" 未承諾の招待はありません
