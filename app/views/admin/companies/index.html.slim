.container-fluid
  .d-flex.justify-content-between.align-items-center.mb-4
    div
      h1.h3.mb-1 契約管理
      .text-muted 利用申込から作成された契約候補と契約中の企業を管理します
    = link_to "新規契約を追加", new_admin_company_path, class: "btn btn-primary"

  .row.g-3.mb-3
    .col-md-4
      .card.shadow-sm.h-100
        .card-body
          .text-muted.small 契約候補
          .fs-3.fw-bold = @companies.count(&:pending_review?)
    .col-md-4
      .card.shadow-sm.h-100
        .card-body
          .text-muted.small 利用中・トライアル
          .fs-3.fw-bold = @companies.count(&:contract_active?)
    .col-md-4
      .card.shadow-sm.h-100
        .card-body
          .text-muted.small 全契約
          .fs-3.fw-bold = @companies.size

  .card.shadow-sm
    .card-header
      strong 契約企業一覧
      span.badge.bg-secondary.ms-2 = @companies.size
    .card-body.p-0
      .table-responsive
        table.table.table-hover.mb-0.align-middle
          thead.table-light
            tr
              th 会社名
              th 申込者
              th 契約状態
              th 契約内容
              th Stripe Customer
              th Stripe Subscription
              th 登録日
              th
          tbody
            - @companies.each do |company|
              tr
                td
                  .fw-semibold = company.name
                  .small.text-muted = company.email
                td = company.representative
                td
                  span.badge class=company.contract_status_badge_class
                    = company.contract_status_label
                td = company.plan_label
                td = company.stripe_customer_id.presence || "-"
                td = company.stripe_subscription_id.presence || "-"
                td = l(company.created_at, format: :short)
                td.text-end
                  = link_to "詳細", admin_company_path(company), class: "btn btn-sm btn-outline-primary"
