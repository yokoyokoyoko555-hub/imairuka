.container-fluid
  .d-flex.justify-content-between.align-items-center.mb-4
    h1.h3 契約管理
    = link_to "新規契約を追加", new_admin_company_path, class: "btn btn-primary"

  .card.shadow-sm
    .card-header
      strong 契約企業一覧
      span.badge.bg-secondary.ms-2 = @companies.size
    .card-body.p-0
      table.table.table-hover.mb-0
        thead.table-light
          tr
            th 会社名
            th 契約状態
            th プラン
            th Stripe Customer
            th Stripe Subscription
            th 登録日
            th
        tbody
          - @companies.each do |company|
            tr
              td = company.name
              td
                span.badge class=(company.contract_active? ? "bg-success" : "bg-secondary")
                  = company.contract_status
              td = company.plan_name
              td = company.stripe_customer_id.presence || "-"
              td = company.stripe_subscription_id.presence || "-"
              td = l(company.created_at, format: :short)
              td.text-end
                = link_to "詳細", admin_company_path(company), class: "btn btn-sm btn-outline-primary"
