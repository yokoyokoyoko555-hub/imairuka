.container-fluid
  .d-flex.justify-content-between.align-items-center.mb-4
    div
      h1.h3.mb-1 契約管理
      .text-muted 利用会社ごとの申込、請求書発行、銀行振込の入金状況を管理します
    = link_to "新しい契約を追加", new_admin_company_path, class: "btn btn-primary"

  .row.g-3.mb-3
    .col-md-3
      .card.shadow-sm.h-100
        .card-body
          .text-muted.small 申込受付
          .fs-3.fw-bold = @companies.count(&:pending_review?)
    .col-md-3
      .card.shadow-sm.h-100
        .card-body
          .text-muted.small 請求済み
          .fs-3.fw-bold = @companies.count(&:billing_invoiced?)
    .col-md-3
      .card.shadow-sm.h-100
        .card-body
          .text-muted.small 入金済み
          .fs-3.fw-bold = @companies.count(&:billing_paid?)
    .col-md-3
      .card.shadow-sm.h-100
        .card-body
          .text-muted.small 契約金額合計
          .fs-3.fw-bold = number_to_currency(@companies.sum(&:contract_amount), unit: "¥", precision: 0)

  .card.shadow-sm
    .card-header
      strong 契約企業一覧
      span.badge.bg-secondary.ms-2 = @companies.size
    .card-body.p-0
      .table-responsive
        table.table.table-hover.mb-0.align-middle
          thead.table-light
            tr
              th 利用会社
              th 販売経路
              th 請求先
              th 契約状態
              th 請求状態
              th 金額
              th 契約期間
              th 登録日
              th
          tbody
            - @companies.each do |company|
              tr
                td
                  .fw-semibold = company.name
                  .small.text-muted = company.email
                td
                  .fw-semibold = company.sales_channel_label
                  - if company.vendor?
                    .small.text-muted = company.vendor&.name || "-"
                td = company.billing_payer_label
                td
                  span.badge class=company.contract_status_badge_class
                    = company.contract_status_label
                td
                  span.badge class=company.billing_status_badge_class
                    = company.billing_status_label
                td = company.contract_amount_label
                td = company.contract_period_label
                td = l(company.created_at, format: :short)
                td.text-end
                  = link_to "詳細", admin_company_path(company), class: "btn btn-sm btn-outline-primary"
