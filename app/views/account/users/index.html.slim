.container-fluid
  .d-flex.justify-content-between.align-items-center.mb-4
    div
      h1.h3.mb-1 ユーザー管理
      .text-muted = "#{current_company.name} のアカウント"
    - if @can_invite_user
      = link_to "ユーザーを招待", new_account_user_invitation_path, class: "btn btn-primary"
    - else
      = button_to "追加アカウントを購入", account_add_user_slot_path, method: :post, class: "btn btn-primary", form: { data: { turbo: false } }

  .row.g-3.mb-3
    .col-lg-8
      .card.shadow-sm.h-100
        .card-header
          strong 月額契約とユーザー枠
        .card-body
          .row.g-3
            .col-sm-3
              .text-muted.small 契約状態
              .fs-5 = current_company.contract_status_label
            .col-sm-3
              .text-muted.small 契約内容
              .fs-5 = current_company.plan_label
            .col-sm-3
              .text-muted.small 使用中
              .fs-5 = "#{current_company.user_slots_used} / #{current_company.user_limit_label}"
            .col-sm-3
              .text-muted.small 追加枠
              .fs-5 = "#{current_company.additional_user_slots.to_i}名"
          .alert class=(@can_invite_user ? "alert-success" : "alert-warning") class="mt-3 mb-0"
            = current_company.user_limit_message

    .col-lg-4
      .card.shadow-sm.h-100
        .card-header
          strong 追加アカウント
        .card-body
          .fs-5.fw-bold = number_to_currency(current_company.additional_user_monthly_amount, unit: "¥", precision: 0)
          .text-muted.small.mb-3 1名あたり月額
          - if @can_invite_user
            .text-muted.small 現在は招待可能な空き枠があります。
          - else
            = button_to "1名分を追加購入", account_add_user_slot_path, method: :post, class: "btn btn-primary w-100", form: { data: { turbo: false } }

  - if flash[:invitation_url].present?
    .alert.alert-info
      .fw-bold.mb-2 招待URL
      .input-group
        input#invitation-url.form-control type="text" readonly="readonly" value=flash[:invitation_url]
        button.btn.btn-outline-primary type="button" onclick="navigator.clipboard.writeText(document.getElementById('invitation-url').value); this.textContent='コピー済み';" コピー
      .small.text-muted.mt-2 URLは再表示できません。必要な場合は未承諾の招待から再発行してください。

  .card.shadow-sm.mb-3
    .card-header
      strong 登録済みユーザー
      span.badge.bg-secondary.ms-2 = @users.size
    .card-body.p-0
      .table-responsive
        table.table.table-hover.align-middle.mb-0
          thead.table-light
            tr
              th メール
              th 名前
              th 権限
              th 状態
              th 最終ログイン
              th 操作
          tbody
            - @users.each do |user|
              tr
                td = user.email
                td style="min-width: 180px;"
                  = form_with model: [:account, user], local: true, class: "d-flex gap-2 align-items-center" do |f|
                    = f.text_field :name, value: user.name, class: "form-control form-control-sm", placeholder: "名前"
                    = f.hidden_field :role, value: user.role
                    = f.submit "保存", class: "btn btn-sm btn-outline-primary"
                td style="min-width: 170px;"
                  = form_with model: [:account, user], local: true, class: "d-flex gap-2 align-items-center" do |f|
                    = f.hidden_field :name, value: user.name
                    = f.select :role, User::ROLE_LABELS.slice(*UserInvitation::INVITABLE_ROLES).map { |role, label| [label, role] }, {}, class: "form-select form-select-sm", disabled: (user == current_user)
                    = f.submit "変更", class: "btn btn-sm btn-outline-primary", disabled: (user == current_user)
                td
                  - if user.active?
                    span.badge.bg-success 有効
                  - else
                    span.badge.bg-secondary 停止
                td = user.last_login_at ? l(user.last_login_at, format: :short) : "-"
                td
                  - if user == current_user
                    span.text-muted.small 操作不可
                  - elsif user.active?
                    = button_to "停止", suspend_account_user_path(user), method: :patch, class: "btn btn-sm btn-outline-danger", form: { data: { turbo: false } }
                  - else
                    = button_to "再開", activate_account_user_path(user), method: :patch, class: "btn btn-sm btn-outline-success", form: { data: { turbo: false } }

  .card.shadow-sm
    .card-header
      strong 未承諾の招待
      span.badge.bg-secondary.ms-2 = @pending_invitations.size
    .card-body.p-0
      .table-responsive
        table.table.table-hover.align-middle.mb-0
          thead.table-light
            tr
              th メール
              th 名前
              th 権限
              th 期限
              th 招待者
              th 操作
          tbody
            - if @pending_invitations.any?
              - @pending_invitations.each do |invitation|
                tr
                  td = invitation.email
                  td = invitation.name.presence || "-"
                  td = invitation.role_label
                  td = l(invitation.expires_at, format: :short)
                  td = invitation.invited_by&.display_name || "-"
                  td
                    .d-flex.gap-2
                      = button_to "再発行", reissue_account_user_invitation_path(invitation), method: :patch, class: "btn btn-sm btn-outline-primary", form: { data: { turbo: false } }
                      = button_to "取消", account_user_invitation_path(invitation), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo: false } }
            - else
              tr
                td.text-muted colspan="6" 未承諾の招待はありません
