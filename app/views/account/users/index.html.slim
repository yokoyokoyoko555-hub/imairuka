.container-fluid
  .d-flex.justify-content-between.align-items-center.mb-4
    div
      h1.h3.mb-1 ユーザー管理
      .text-muted = "#{current_company.name} のアカウント"
    = link_to "ユーザーを招待", new_account_user_invitation_path, class: "btn btn-primary"

  - if flash[:invitation_url].present?
    .alert.alert-info
      .fw-bold.mb-2 招待URL
      input.form-control.mb-2 type="text" readonly="readonly" value=flash[:invitation_url]
      .small.text-muted このURLを招待相手に共有してください。メール送信はSMTP設定後に追加できます。

  .card.shadow-sm.mb-3
    .card-header
      strong 登録済みユーザー
      span.badge.bg-secondary.ms-2 = @users.size
    .card-body.p-0
      table.table.table-hover.mb-0
        thead.table-light
          tr
            th メール
            th 名前
            th 権限
            th 状態
            th 最終ログイン
        tbody
          - @users.each do |user|
            tr
              td = user.email
              td = user.name.presence || "-"
              td = user.role
              td = user.active? ? "有効" : "停止"
              td = user.last_login_at ? l(user.last_login_at, format: :short) : "-"

  .card.shadow-sm
    .card-header
      strong 未承諾の招待
      span.badge.bg-secondary.ms-2 = @pending_invitations.size
    .card-body.p-0
      table.table.table-hover.mb-0
        thead.table-light
          tr
            th メール
            th 名前
            th 権限
            th 期限
            th 招待者
        tbody
          - if @pending_invitations.any?
            - @pending_invitations.each do |invitation|
              tr
                td = invitation.email
                td = invitation.name.presence || "-"
                td = invitation.role
                td = l(invitation.expires_at, format: :short)
                td = invitation.invited_by&.display_name || "-"
          - else
            tr
              td.text-muted colspan="5" 未承諾の招待はありません
