= form_with model: @order_status, local: true, data: { controller: 'color-picker' } do |f|
  = render 'shared/error_messages', model: @order_status

  .row.mb-3
    .col-md-6
      = f.label :name, 'ステータス名', class: 'form-label required'
      = f.text_field :name, class: 'form-control', required: true, maxlength: 50
    .col-md-6
      = f.label :code, 'ステータスコード', class: 'form-label required'
      = f.text_field :code, class: 'form-control', required: true, \
        pattern: '[a-z0-9_]+', \
        title: '半角英数字とアンダースコアのみ使用できます', \
        maxlength: 20
      small.form-text.text-muted 半角英数字とアンダースコアのみ使用できます

  .row.mb-3
    .col-md-6
      = f.label :display_order, '表示順', class: 'form-label required'
      = f.number_field :display_order, class: 'form-control', required: true, min: 1
    .col-md-6
      = f.label :color, '表示色', class: 'form-label'
      .input-group data-color-picker-target="container"
        = f.color_field :color, class: 'form-control form-control-color', \
          value: @order_status.color.presence || '#0d6efd', \
          data: { action: 'change->color-picker#updateText', color_picker_target: 'colorInput' }
        = f.text_field :color, class: 'form-control', \
          pattern: '#[0-9a-fA-F]{6}', \
          title: '16進数のカラーコード（例：#FF0000）で指定してください', \
          maxlength: 7, \
          data: { action: 'change->color-picker#updateColor', color_picker_target: 'textInput' }
      small.form-text.text-muted カラーピッカーから選択するか、16進数のカラーコードを直接入力してください

  .row.mb-3
    .col-12
      = f.label :description, '説明', class: 'form-label'
      = f.text_area :description, class: 'form-control', rows: 3, maxlength: 200

  .row.mb-3
    .col-12
      .form-check
        = f.check_box :is_active, class: 'form-check-input'
        = f.label :is_active, '有効', class: 'form-check-label'

  .row
    .col-12
      .d-flex.justify-content-end.gap-2
        = f.submit @order_status.new_record? ? '登録' : '更新', class: 'btn btn-primary'
        = link_to 'キャンセル', order_statuses_path, class: 'btn btn-outline-secondary' 