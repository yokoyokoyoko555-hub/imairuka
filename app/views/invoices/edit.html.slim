.container-fluid
  .row.mb-4
    .col
      h1.h3.mb-3.text-gray-800
        i.bi.bi-file-text.me-2
        | 請求書編集
      .d-flex.justify-content-end.gap-2
        = link_to invoice_path(@invoice), class: 'btn btn-outline-secondary' do
          i.bi.bi-arrow-left.me-1
          | 詳細に戻る

  = form_with model: @invoice, class: 'needs-validation' do |f|
    = render 'shared/error_messages', model: f.object
    .row
      .col-lg-8
        .card.shadow.mb-4
          .card-header.py-3
            h6.m-0.font-weight-bold.text-primary
              i.bi.bi-info-circle.me-2
              | 基本情報
          .card-body
            .row.mb-3
              .col-md-6
                = f.label :invoice_number, "請求書番号", class: 'form-label'
                small.text-muted 請求書番号は変更できません
                = f.text_field :invoice_number, class: 'form-control', readonly: true
              .col-md-6
                = f.label :invoice_date, "請求日", class: 'form-label'
                = f.date_field :invoice_date, class: 'form-control', required: true
            .row.mb-3
              .col-md-6
                = f.label :transaction_date, "取引年月日", class: 'form-label'
                = f.date_field :transaction_date, class: 'form-control', required: true
            .row.mb-3
              .col-md-12
                = f.label :subject, "件名", class: 'form-label'
                = f.text_field :subject, class: 'form-control', required: true, maxlength: 200
            .row.mb-3
              .col-md-6
                = f.label :customer_name, "顧客名", class: 'form-label'
                = f.text_field :customer_name, class: 'form-control', required: true, maxlength: 100
              .col-md-6
                = f.label :staff_name, "担当者名", class: 'form-label'
                = f.text_field :staff_name, class: 'form-control', required: true, maxlength: 50
            .row.mb-3
              .col-md-12
                = f.label :customer_address, "顧客住所", class: 'form-label'
                = f.text_field :customer_address, class: 'form-control', maxlength: 200
            .row.mb-3
              .col-md-6
                = f.label :payment_due_date, "支払期限", class: 'form-label'
                = f.date_field :payment_due_date, class: 'form-control', required: true
              .col-md-6
                = f.label :status, "ステータス", class: 'form-label'
                = f.select :status, Invoice.statuses.keys.map { |s| [t("enums.invoice.status.#{s}"), s] }, {}, class: 'form-select'
            .row.mb-3
              .col-md-12
                = f.label :payment_method, "支払方法", class: 'form-label'
                = f.text_field :payment_method, class: 'form-control', placeholder: '例：銀行振込', maxlength: 100
            .row.mb-3
              .col-md-12
                = f.label :notes, "備考", class: 'form-label'
                = f.text_area :notes, class: 'form-control', rows: 3, maxlength: 1000

        .card.shadow.mb-4
          .card-header.py-3.d-flex.justify-content-between.align-items-center
            h6.m-0.font-weight-bold.text-primary
              i.bi.bi-cart.me-2
              | 請求商品
            button.btn.btn-sm.btn-primary[type="button" data-bs-toggle="modal" data-bs-target="#addItemModal"]
              i.bi.bi-plus.me-1
              | 商品を追加
          .card-body
            .table-responsive
              table.table.table-bordered
                thead.table-light
                  tr
                    th 商品コード
                    th 商品名
                    th.text-end 単価
                    th.text-end 数量
                    th.text-end 金額
                    th 税率
                    th 操作
                tbody#invoice-items
                  / 削除マークが付いていない商品のみ表示
                  - visible_items = @invoice.invoice_items.reject(&:marked_for_destruction?)
                  - if visible_items.any?
                    - visible_items.each_with_index do |item, index|
                      tr.item-row
                        = f.fields_for :invoice_items, item do |item_form|
                          = item_form.hidden_field :id
                          td
                            = item_form.text_field :product_code, class: 'form-control', required: true, maxlength: 20
                          td
                            = item_form.text_field :product_name, class: 'form-control', required: true, maxlength: 100
                          td.text-end
                            = item_form.number_field :unit_price, class: 'form-control text-end', min: 0, step: 1, required: true
                          td.text-end
                            = item_form.number_field :quantity, class: 'form-control text-end', min: 1, step: 1, required: true
                          td.text-end
                            span.item-amount = number_to_currency((item.unit_price || 0) * (item.quantity || 0), unit: '¥', precision: 0)
                          td
                            = item_form.select :tax_rate, [['選択してください', ''], ['10%', 1], ['8% (軽減税率)', 2], ['8%', 3], ['0%', 4]], {}, class: 'form-select'
                          td
                            button.btn.btn-sm.btn-outline-danger.remove-item type="button"
                              i.bi.bi-trash
                  - else
                    / 商品がない場合のメッセージ
                    tr#no-items-message
                      td.text-center[colspan="7"] 
                        .text-muted
                          i.bi.bi-cart.me-2
                          | 商品を追加してください
                
                / 削除マークが付いた商品の_destroyフィールドを隠しフィールドとして追加
                - @invoice.invoice_items.select(&:marked_for_destruction?).each do |item|
                  = f.fields_for :invoice_items, item do |item_form|
                    = item_form.hidden_field :id
                    = item_form.hidden_field :_destroy
                tfoot
                  tr
                    td[colspan="4"]
                    td.text-end 合計金額
                    td.text-end#total-amount = number_to_currency(@invoice.invoice_items.reject(&:marked_for_destruction?).sum { |item| (item.unit_price || 0) * (item.quantity || 0) }, unit: "¥", precision: 0)
                    td

      .col-lg-4
        .card.shadow.mb-4
          .card-header.py-3
            h6.m-0.font-weight-bold.text-primary
              i.bi.bi-gear.me-2
              | 操作
          .card-body
            .d-grid.gap-2
              = f.submit '更新', class: 'btn btn-primary'
              = f.submit "一時保存", class: "btn btn-outline-info", name: "save_draft"
              = link_to print_invoice_path(@invoice), class: 'btn btn-outline-info', target: '_blank' do
                i.bi.bi-printer.me-1
                | プレビュー
              = link_to 'キャンセル', invoice_path(@invoice), class: 'btn btn-outline-secondary'

/ 商品追加モーダル
#addItemModal.modal.fade[tabindex="-1"]
  .modal-dialog.modal-lg
    .modal-content
      .modal-header
        h5.modal-title 商品を追加
        button.btn-close[type="button" data-bs-dismiss="modal"]
      .modal-body
        .mb-3
          input.form-control[type="text" id="productSearch" placeholder="商品コードまたは商品名で検索"]
        .table-responsive
          table.table.table-hover
            thead
              tr
                th 商品コード
                th 商品名
                th.text-end 単価
                th 操作
            tbody#productList
              tr
                td.text-center[colspan="4"] 商品を検索してください
      .modal-footer
        button.btn.btn-secondary[type="button" data-bs-dismiss="modal"] 閉じる

= javascript_include_tag "invoice_form"


javascript:
  document.addEventListener('DOMContentLoaded', function() {
    // 一時保存ボタンがクリックされた時にrequired属性を削除
    const saveDraftButton = document.querySelector('input[name="save_draft"]');
    if (saveDraftButton) {
      saveDraftButton.addEventListener('click', function() {
        // 一時保存時はrequired属性を削除
        document.querySelectorAll('[required]').forEach(function(field) {
          field.removeAttribute('required');
        });
      });
    }
    
    const itemsContainer = document.getElementById('invoice-items');
    
    // 商品行の削除処理
    itemsContainer.addEventListener('click', function(e) {
      if (e.target.closest('.remove-item')) {
        const row = e.target.closest('tr');
        const hiddenIdField = row.querySelector('input[name*="[id]"]');
        
        if (hiddenIdField && hiddenIdField.value) {
          // 既存の商品の場合、削除マークを付けて非表示にする
          const destroyField = document.createElement('input');
          destroyField.type = 'hidden';
          destroyField.name = hiddenIdField.name.replace('[id]', '[_destroy]');
          destroyField.value = '1';
          row.appendChild(destroyField);
          row.style.display = 'none';
        } else {
          // 新規追加の商品の場合、行を削除
          row.remove();
        }
        
        // 表示されている商品行をチェック
        const visibleRows = itemsContainer.querySelectorAll('tr.item-row:not([style*="display: none"])');
        if (visibleRows.length === 0) {
          // 商品がない場合、メッセージを表示
          showNoItemsMessage();
        }
        
        updateTotal();
      }
    });
    
    // 商品追加時の処理も追加
    document.addEventListener('click', function(e) {
      if (e.target.closest('.add-item')) {
        // 商品追加後に合計金額を更新
        setTimeout(updateTotal, 100);
      }
    });
    
    // メッセージ表示関数
    function showNoItemsMessage() {
      // 既存のメッセージを削除
      hideNoItemsMessage();
      
      // 新しいメッセージを作成
      const messageHtml = `
        <tr id="no-items-message">
          <td class="text-center" colspan="7">
            <div class="text-muted">
              <i class="bi bi-cart me-2"></i>商品を追加してください
            </div>
          </td>
        </tr>
      `;
      
      itemsContainer.insertAdjacentHTML('beforeend', messageHtml);
    }
    
    // メッセージ非表示関数
    function hideNoItemsMessage() {
      const noItemsMessage = document.getElementById('no-items-message');
      if (noItemsMessage) {
        noItemsMessage.remove();
      }
    }
    
    // 金額計算処理
    function updateTotal() {
      let total = 0;
      const visibleRows = itemsContainer.querySelectorAll('tr.item-row:not([style*="display: none"])');
      
      visibleRows.forEach(function(row) {
        const unitPrice = parseFloat(row.querySelector('input[name*="[unit_price]"]').value) || 0;
        const quantity = parseFloat(row.querySelector('input[name*="[quantity]"]').value) || 0;
        const amount = unitPrice * quantity;
        
        row.querySelector('.item-amount').textContent = '¥' + amount.toLocaleString();
        total += amount;
      });
      
      document.getElementById('total-amount').textContent = '¥' + total.toLocaleString();
    }
    
    // 初期化時に金額を計算
    updateTotal();
    
    // 金額変更時の再計算
    itemsContainer.addEventListener('input', function(e) {
      if (e.target.name && (e.target.name.includes('[unit_price]') || e.target.name.includes('[quantity]'))) {
        updateTotal();
      }
    });
  }); 