.container-fluid
  .row.mb-4
    .col
      h1.h3.mb-3.text-gray-800
        i.bi.bi-file-earmark-text.me-2
        | 請求書管理
      .d-flex.justify-content-end
        = link_to new_invoice_path, class: 'btn btn-primary' do
          i.bi.bi-plus.me-1
          | 新規作成

  / 検索フィルター
  .card.shadow.mb-4
    .card-header.py-3
      h6.m-0.font-weight-bold.text-primary
        i.bi.bi-search.me-2
        | 検索条件
    .card-body
      = search_form_for @q, url: invoices_path, class: "row g-3" do |f|
        .col-md-3
          = f.label :invoice_number_cont, "請求書番号", class: "form-label"
          = f.text_field :invoice_number_cont, class: "form-control"
        .col-md-3
          = f.label :customer_name_cont, "顧客名", class: "form-label"
          = f.text_field :customer_name_cont, class: "form-control"
        .col-md-2
          = f.label :status_eq, "ステータス", class: "form-label"
          = f.select :status_eq, [["全て", ""], ["送付待ち", "pending"], ["送付済み", "sent"], ["入金待ち", "waiting_payment"], ["入金済み", "paid"]], {}, class: "form-select"
        .col-md-2
          = f.label :invoice_date_gteq, "作成日（From）", class: "form-label"
          = f.date_field :invoice_date_gteq, class: "form-control"
        .col-md-2
          = f.label :invoice_date_lteq, "作成日（To）", class: "form-label"
          = f.date_field :invoice_date_lteq, class: "form-control"
        .col-12
          = f.submit "検索", class: "btn btn-primary me-2"
          = link_to "リセット", invoices_path, class: "btn btn-outline-secondary"

  / 請求書一覧
  .card.shadow.mb-4
    .card-header.py-3.d-flex.justify-content-between.align-items-center
      h6.m-0.font-weight-bold.text-primary
        i.bi.bi-list.me-2
        | 請求書一覧
        span.badge.bg-secondary.ms-2 = @invoices.total_count

    .card-body
      .table-responsive
        table.table.table-bordered.table-hover.table-stable.document-table
          thead.table-light
            tr
              th style="width: 118px;" 請求書番号
              th style="width: 132px;" 作成日
              th style="width: 180px;" 顧客名
              th 案件名
              th.text-end style="width: 104px;" 金額
              th style="width: 132px;" 支払期限
              th style="width: 130px;" 担当者
              th.status-cell ステータス
              th.action-cell 操作
          tbody
            - @invoices.each do |invoice|
              tr
                td.text-nowrap-cell = invoice.invoice_number
                td.text-nowrap-cell = format_date(invoice.invoice_date)
                td.text-wrap-cell = invoice.customer_name
                td.text-wrap-cell = invoice.subject.presence || "-"
                td.text-end.text-nowrap-cell = number_to_currency(invoice.total_amount_with_tax, unit: "¥", precision: 0)
                td.text-nowrap-cell = format_date(invoice.payment_due_date)
                td.text-wrap-cell = invoice.staff_name
                td
                  - if invoice.draft?
                    span.badge.bg-warning style="color: #FFFFFF; text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000;"
                      | 一時保存
                  - else
                    span.badge class="bg-#{invoice.status_color}" style="color: #FFFFFF; text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000;"
                      = invoice.status_text
                td
                  .action-buttons
                    = link_to invoice_path(invoice), class: 'btn btn-sm btn-outline-primary', title: '詳細' do
                      i.bi.bi-eye
                    = link_to edit_invoice_path(invoice), class: 'btn btn-sm btn-outline-secondary', title: '編集' do
                      i.bi.bi-pencil
                    = link_to print_invoice_path(invoice), class: 'btn btn-sm btn-outline-info', target: '_blank', title: 'プレビュー' do
                      i.bi.bi-printer
                    = link_to invoice_path(invoice), class: 'btn btn-sm btn-outline-danger', title: '削除', data: { delete_action: true, confirm: 'この請求書を削除してもよろしいですか？\nこの操作は取り消せません。' } do
                      i.bi.bi-trash

      / ページネーション
      .d-flex.justify-content-center.mt-4
        = paginate @invoices

= javascript_include_tag "delete_actions" 
