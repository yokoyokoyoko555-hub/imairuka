.container-fluid
  .row.mb-4
    .col
      h1.h3.mb-3.text-gray-800
        i.bi.bi-people.me-2
        | 顧客管理
      .d-flex.justify-content-end
        = link_to new_customer_path, class: 'btn btn-primary write-action' do
          i.bi.bi-plus.me-1
          | 新規作成

  / 検索条件
  .card.shadow.mb-4
    .card-header.py-3
      h6.m-0.font-weight-bold.text-primary
        i.bi.bi-search.me-2
        | 検索条件
    .card-body
      = form_with url: customers_path, method: :get, class: "row g-3" do |f|
        .col-md-3
          = f.label :company_name, "会社名", class: "form-label"
          = f.text_field :company_name, class: "form-control", placeholder: "会社名を入力...", value: params[:company_name]
        .col-md-3
          = f.label :industry, "業種", class: "form-label"
          = f.select :industry, [["IT", "IT"], ["製造業", "製造業"], ["サービス業", "サービス業"], ["小売業", "小売業"], ["その他", "その他"]], { include_blank: "選択してください", selected: params[:industry] }, class: "form-select"
        .col-md-3
          = f.label :status, "ステータス", class: "form-label"
          = f.select :status, [["取引中", "active"], ["見込み", "prospect"], ["取引終了", "inactive"]], { include_blank: "選択してください", selected: params[:status] }, class: "form-select"
        .col-md-3
          = f.label :sort, "並び順", class: "form-label"
          = f.select :sort, [["会社名（昇順）", "company_name_asc"], ["会社名（降順）", "company_name_desc"], ["最終取引日（降順）", "last_transaction_desc"]], { include_blank: "選択してください", selected: params[:sort] }, class: "form-select"
        .col-12
          = f.submit "検索", class: "btn btn-primary me-2"
          = link_to "リセット", customers_path, class: "btn btn-outline-secondary"

  / 顧客一覧
  .card.shadow.mb-4
    .card-header.py-3.d-flex.justify-content-between.align-items-center
      h6.m-0.font-weight-bold.text-primary
        i.bi.bi-list.me-2
        | 顧客一覧
        span.badge.bg-secondary.ms-2 = @customers.total_count
      .btn-group
        button.btn.btn-sm.btn-outline-secondary.dropdown-toggle[type="button" data-bs-toggle="dropdown" aria-expanded="false" data-bulk-actions-target="actionButton" disabled]
          i.bi.bi-three-dots-vertical.me-1
          | 一括操作
        ul.dropdown-menu.dropdown-menu-end
          li
            = link_to "#", class: "dropdown-item text-danger", data: { action: "bulkDelete" } do
              i.bi.bi-trash.me-2
              | 一括削除
    .card-body
      .table-responsive
        table.table.table-bordered.table-hover
          thead.table-light
            tr
              th
                .form-check
                  input.form-check-input[type="checkbox" data-bulk-actions-target="selectAll"]
              th 顧客コード
              th 会社名
              th 業種
              th 代表者名
              th 電話番号
              th メールアドレス
              th ステータス
              th 取引回数
              th 最終取引日
              th 操作
          tbody
            - @customers.each do |customer|
              tr
                td
                  .form-check
                    input.form-check-input[type="checkbox" name="selected_customers[]" value=customer.id data-bulk-actions-target="checkbox"]
                td = customer.code
                td = customer.company_name
                td = customer.industry
                td = customer.representative_name
                td = customer.phone
                td = customer.email
                td
                  - if customer.draft?
                    span.badge.bg-warning style="color: #FFFFFF; text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000;"
                      | 一時保存
                  - else
                    span.badge class="bg-#{customer.status == 'active' ? 'success' : customer.status == 'prospect' ? 'warning' : 'secondary'}" style="color: #FFFFFF; text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000;"
                      = customer.status_text
                td
                  = customer.transaction_count
                  | 回
                td
                  = customer.last_transaction_date&.strftime("%Y/%m/%d") || "-"
                td style="white-space: nowrap;"
                  .btn-group
                    = link_to customer_path(customer), class: "btn btn-sm btn-outline-primary" do
                      i.bi.bi-eye.me-1
                      | 詳細
                    = link_to edit_customer_path(customer), class: "btn btn-sm btn-outline-secondary" do
                      i.bi.bi-pencil.me-1
                      | 編集
                    = link_to customer_path(customer), \
                        data: { delete_action: true, confirm: "この顧客を削除してもよろしいですか？\nこの操作は取り消せません。" }, \
                        class: "btn btn-sm btn-outline-danger" do
                      i.bi.bi-trash.me-1
                      | 削除

      / ページネーション
      .d-flex.justify-content-center.mt-4
        = paginate @customers

= javascript_include_tag "bulk_actions"
= javascript_include_tag "delete_actions"
