.container-fluid
  .row.mb-4
    .col
      h1.h3.mb-3.text-gray-800
        i.bi.bi-receipt.me-2
        | 請求管理
      .d-flex.justify-content-end
        = link_to orders_path, class: 'btn btn-outline-secondary' do
          i.bi.bi-arrow-left.me-1
          | 一覧に戻る

  / 検索フィルター
  .card.shadow.mb-4
    .card-header.py-3
      h6.m-0.font-weight-bold.text-primary
        i.bi.bi-search.me-2
        | 検索条件
    .card-body
      = form_with url: billing_orders_path, method: :get, local: true, class: "row g-3" do |f|
        .col-md-3
          = f.label :order_number, "案件番号", class: "form-label"
          = f.text_field :order_number, class: "form-control", value: params[:order_number]
        .col-md-3
          = f.label :customer_name, "顧客名", class: "form-label"
          = f.text_field :customer_name, class: "form-control", value: params[:customer_name]
        .col-md-2
          = f.label :status, "ステータス", class: "form-label"
          = f.select :status, \
            [["全て", ""]] + OrderStatus.active.ordered.map { |s| [s.name, s.code] }, \
            { selected: params[:status] }, \
            class: "form-select"
        .col-md-2
          = f.label :payment_due_date_from, "支払期限（From）", class: "form-label"
          = f.date_field :payment_due_date_from, class: "form-control", value: params[:payment_due_date_from]
        .col-md-2
          = f.label :payment_due_date_to, "支払期限（To）", class: "form-label"
          = f.date_field :payment_due_date_to, class: "form-control", value: params[:payment_due_date_to]
        .col-12
          = f.submit "検索", class: "btn btn-primary me-2"
          = link_to "リセット", billing_orders_path, class: "btn btn-outline-secondary"

  / 請求一覧
  .card.shadow.mb-4
    .card-header.py-3.d-flex.justify-content-between.align-items-center
      h6.m-0.font-weight-bold.text-primary
        i.bi.bi-list.me-2
        | 請求一覧
        span.badge.bg-secondary.ms-2 = @orders.total_count

    .card-body
      .table-responsive
        table.table.table-bordered.table-hover
          thead.table-light
            tr
              th 案件番号
              th 注文日
              th 顧客名
              th 案件名
              th 合計金額
              th 支払期限
              th 支払方法
              th ステータス
              th 操作
          tbody
            - @orders.each do |order|
              tr
                td = order.order_number
                td.text-nowrap = order.order_date.strftime('%Y/%m/%d')
                td = order.customer&.name || ""
                td = order.project_name.presence || "-"
                td.text-end.text-nowrap = number_to_currency(order.total_amount, unit: "¥", precision: 0)
                td.text-nowrap = order.payment_due_date&.strftime('%Y/%m/%d') || '未設定'
                td = Order.payment_method_text(order.payment_method).presence || '未設定'
                td
                  - if order.order_status
                    span.badge style="background-color: #{order.order_status.color.presence || '#6c757d'}; color: #FFFFFF; text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000;"
                      = order.order_status.name
                  - else
                    span.badge.bg-secondary ステータス未設定
                td
                  .btn-group
                    = link_to show_billing_order_path(order), class: "btn btn-sm btn-outline-primary" do
                      i.bi.bi-eye.me-1
                      | 詳細

      / ページネーション
      .d-flex.justify-content-center.mt-4
        = paginate @orders
