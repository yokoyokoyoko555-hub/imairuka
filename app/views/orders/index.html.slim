.container-fluid
  .row.mb-4
    .col
      h1.h3.mb-3.text-gray-800
        i.bi.bi-cart.me-2
        | 案件一覧
      .d-flex.justify-content-end
        = link_to new_order_path, class: "btn btn-primary" do
          i.bi.bi-plus.me-1
          | 案件登録

  .card.shadow.mb-4
    .card-header.py-3
      h6.m-0.font-weight-bold.text-primary
        i.bi.bi-search.me-2
        | 検索条件
    .card-body
      = form_with url: orders_path, method: :get, class: "row g-3" do |f|
        .col-md-4
          = f.label :customer_name, "顧客名", class: "form-label"
          = f.text_field :customer_name, class: "form-control", value: params[:customer_name]
        .col-md-3
          = f.label :status, "ステータス", class: "form-label"
          = f.select :status, [["すべて", ""]] + OrderStatus.active.ordered.map { |s| [s.name, s.code] }, { selected: params[:status] }, class: "form-select"
        .col-md-2
          = f.label :date_from, "注文日 From", class: "form-label"
          = f.date_field :date_from, class: "form-control", value: params[:date_from]
        .col-md-2
          = f.label :date_to, "注文日 To", class: "form-label"
          = f.date_field :date_to, class: "form-control", value: params[:date_to]
        .col-md-1.d-flex.align-items-end
          = f.submit "検索", class: "btn btn-primary w-100"
        .col-12
          = link_to "リセット", orders_path, class: "btn btn-outline-secondary"

  .card.shadow.mb-4
    .card-header.py-3.d-flex.justify-content-between.align-items-center
      h6.m-0.font-weight-bold.text-primary
        i.bi.bi-list.me-2
        | 案件一覧
        span.badge.bg-secondary.ms-2 = @total_count
      .btn-group
        button.btn.btn-sm.btn-outline-secondary.dropdown-toggle[type="button" data-bs-toggle="dropdown" aria-expanded="false" data-bulk-actions-target="actionButton" disabled]
          i.bi.bi-three-dots-vertical.me-1
          | 一括操作
        ul.dropdown-menu.dropdown-menu-end
          li
            = link_to "#", class: "dropdown-item text-danger", data: { action: "bulkDelete" } do
              i.bi.bi-trash.me-2
              | 一括削除

    .card-body
      .table-responsive
        table.table.table-bordered.table-hover.align-middle.table-stable.document-table
          thead.table-light
            tr
              th style="width: 44px;"
                .form-check
                  input.form-check-input[type="checkbox" data-bulk-actions-target="selectAll"]
              th style="width: 150px;" 案件番号
              th style="width: 112px;" 注文日
              th style="width: 180px;" 顧客名
              th 案件名
              th.text-end style="width: 112px;" 金額
              th.status-cell ステータス
              th style="width: 120px;" 担当者
              th.action-cell 操作
          tbody
            - @orders.each do |order|
              tr
                td
                  .form-check
                    input.form-check-input[type="checkbox" name="selected_orders[]" value=order.id data-bulk-actions-target="checkbox" class="order-checkbox"]
                td.text-nowrap-cell = order.draft? ? (order.display_order_number.presence || "未設定") : order.display_order_number
                td.text-nowrap-cell = order.order_date.strftime("%Y/%m/%d")
                td.text-wrap-cell = order.customer&.name || ""
                td.text-wrap-cell = order.project_name.presence || "-"
                td.text-end.text-nowrap-cell = number_to_currency(order.total_amount, unit: "¥", precision: 0)
                td
                  - if order.draft?
                    span.badge.bg-warning.text-dark 一時保存
                  - else
                    span.badge style="background-color: #{order.order_status.color.presence || '#6c757d'}; color: #fff;"
                      = order.order_status.name
                td.text-wrap-cell = order.staff_name
                td
                  .action-buttons
                    = link_to order_path(order), class: "btn btn-sm btn-outline-primary", title: "詳細" do
                      i.bi.bi-eye
                    = link_to edit_order_path(order), class: "btn btn-sm btn-outline-secondary", title: "編集" do
                      i.bi.bi-pencil
                    = link_to order_path(order), data: { delete_action: true, confirm: "この案件を削除してもよろしいですか？\nこの操作は取り消せません。" }, class: "btn btn-sm btn-outline-danger", title: "削除" do
                      i.bi.bi-trash

      .d-flex.justify-content-center.mt-4
        = paginate @orders

= javascript_include_tag "bulk_actions"
= javascript_include_tag "delete_actions"
