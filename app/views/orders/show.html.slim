.container-fluid
  .row.mb-4
    .col
      h1.h3.mb-3.text-gray-800
        i.bi.bi-cart.me-2
        | 案件詳細
      .d-flex.justify-content-end
        = link_to orders_path, class: "btn btn-outline-secondary me-2" do
          i.bi.bi-arrow-left.me-1
          | 一覧に戻る
        = link_to edit_order_path(@order), class: "btn btn-outline-primary write-action" do
          i.bi.bi-pencil.me-1
          | 編集

  .row
    .col-lg-8
      .card.shadow.mb-4
        .card-header.py-3.d-flex.justify-content-between.align-items-center
          h6.m-0.font-weight-bold.text-primary
            i.bi.bi-info-circle.me-2
            | 基本情報
          button.btn.btn-sm.btn-outline-secondary[type="button" data-bs-toggle="collapse" data-bs-target="#orderBasicInfo" aria-expanded="true" aria-controls="orderBasicInfo"]
            i.bi.bi-chevron-down.me-1
            | 開閉
        #orderBasicInfo.collapse.show
          .card-body
            .row.g-3
              .col-md-6
                .small.text-muted 案件番号
                .fw-semibold = @order.display_order_number
              .col-md-6
                .small.text-muted 注文日
                .fw-semibold = @order.order_date.strftime("%Y年%m月%d日")
              .col-md-6
                .small.text-muted 顧客名
                .fw-semibold = @order.customer&.name || "-"
              .col-md-6
                .small.text-muted 案件名
                .fw-semibold = @order.project_name.presence || "-"
              .col-12
                .small.text-muted 案件概要
                .border.rounded.bg-light.p-3 = simple_format(@order.project_summary.presence || "-")
              .col-md-6
                .small.text-muted 担当者
                .fw-semibold = @order.staff_name.presence || "-"
              .col-md-6
                .small.text-muted ステータス
                .fw-semibold = @order.order_status&.name || "-"
              .col-md-6
                .small.text-muted 支払期限
                .fw-semibold = @order.payment_due_date&.strftime("%Y年%m月%d日") || "未設定"
              .col-md-6
                .small.text-muted 支払方法
                .fw-semibold = Order.payment_method_text(@order.payment_method).presence || "未設定"
              .col-md-6
                .small.text-muted 納品日
                .fw-semibold = @order.delivery_date&.strftime("%Y年%m月%d日") || "未設定"
              .col-md-6
                .small.text-muted 納品先
                .fw-semibold = @order.delivery_address.presence || "未設定"
              .col-md-6
                .small.text-muted 合計金額
                .fw-semibold = number_to_currency(@order.total_amount, unit: "¥", precision: 0)
              .col-md-6
                .small.text-muted 備考
                .fw-semibold = @order.notes.presence || "-"

      .card.shadow.mb-4
        .card-header.py-3
          h6.m-0.font-weight-bold.text-primary
            i.bi.bi-cart.me-2
            | 注文商品
        .card-body
          table.table.table-bordered
            thead.table-light
              tr
                th 商品名
                th.text-end 単価
                th.text-end 数量
                th.text-end 金額
            tbody
              - @order.order_items.each do |item|
                tr
                  td = item.product.name
                  td.text-end = number_to_currency(item.unit_price, unit: "¥", precision: 0)
                  td.text-end = item.quantity
                  td.text-end = number_to_currency(item.amount, unit: "¥", precision: 0)
            tfoot
              tr
                td.text-end colspan="3" 合計
                td.text-end = number_to_currency(@order.total_amount, unit: "¥", precision: 0)

    .col-lg-4
      .card.shadow.mb-4
        .card-header.py-3
          h6.m-0.font-weight-bold.text-primary
            i.bi.bi-gear.me-2
            | 操作
        .card-body
          .d-grid.gap-2
            = link_to project_management_path(@order), class: "btn btn-primary" do
              i.bi.bi-kanban.me-1
              | 案件管理
            = link_to show_billing_order_path(@order), class: "btn btn-outline-primary" do
              i.bi.bi-receipt.me-1
              | 請求・決済
            = link_to edit_order_path(@order), class: "btn btn-outline-primary write-action" do
              i.bi.bi-pencil.me-1
              | 編集
            = link_to order_path(@order), data: { delete_action: true, confirm: "この案件を削除してもよろしいですか？\nこの操作は取り消せません。" }, class: "btn btn-outline-danger write-action" do
              i.bi.bi-trash.me-1
              | 削除

      .card.shadow.mb-4
        .card-header.py-3
          h6.m-0.font-weight-bold.text-primary
            i.bi.bi-clock-history.me-2
            | 処理履歴
        .card-body.p-3
          - if @order.histories.any?
            .small
              - @order.histories.order(created_at: :desc).limit(8).each do |history|
                .border-bottom.pb-2.mb-2
                  .fw-semibold = history.description
                  .text-muted = history.created_at.strftime("%Y/%m/%d %H:%M")
          - else
            .text-muted.small 履歴はまだありません。

= javascript_include_tag "delete_actions"
