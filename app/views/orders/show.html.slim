.container-fluid
  .row.mb-4
    .col
      h1.h3.mb-3.text-gray-800
        i.bi.bi-cart.me-2
        | 案件詳細
      .d-flex.justify-content-end
        = link_to orders_path, class: 'btn btn-outline-secondary me-2' do
          i.bi.bi-arrow-left.me-1
          | 一覧に戻る
        = link_to edit_order_path(@order), class: 'btn btn-outline-primary' do
          i.bi.bi-pencil.me-1
          | 編集

  .row
    .col-lg-8
      / 基本情報
      .card.shadow.mb-4
        .card-header.py-3
          h6.m-0.font-weight-bold.text-primary
            i.bi.bi-info-circle.me-2
            | 基本情報
        .card-body
          .row.mb-3
            .col-md-6
              label.form-label 案件番号
              p.form-control-plaintext = @order.order_number
            .col-md-6
              label.form-label 注文日
              p.form-control-plaintext = @order.order_date.strftime('%Y年%m月%d日')
          .row.mb-3
            .col-md-6
              label.form-label 顧客
              p.form-control-plaintext = @order.customer&.name || ""
            .col-md-6
              label.form-label 担当者
              p.form-control-plaintext = @order.staff_name
          .row.mb-3
            .col-md-6
              label.form-label 納品日
              p.form-control-plaintext = @order.delivery_date&.strftime('%Y年%m月%d日') || '未設定'
            .col-md-6
              label.form-label 納品先
              p.form-control-plaintext = @order.delivery_address.presence || '未設定'
          .row.mb-3
            .col-md-6
              label.form-label 支払期限
              p.form-control-plaintext = @order.payment_due_date&.strftime('%Y年%m月%d日') || '未設定'
            .col-md-6
              label.form-label 支払方法
              p.form-control-plaintext = Order.payment_method_text(@order.payment_method).presence || '未設定'
          .row.mb-3
            .col-md-6
              label.form-label ステータス
              p.form-control-plaintext = @order.order_status&.name
            .col-md-6
              label.form-label 合計金額
              p.form-control-plaintext = number_to_currency(@order.total_amount, unit: '¥', precision: 0)
          .row.mb-3
            .col-12
              label.form-label 備考
              p.form-control-plaintext = @order.notes.presence || 'なし'

      / 注文商品
      .card.shadow.mb-4
        .card-header.py-3
          h6.m-0.font-weight-bold.text-primary
            i.bi.bi-cart.me-2
            | 注文商品
        .card-body
          table.table.table-bordered
            thead.table-light
              tr
                th 商品名
                th.text-end 単価
                th.text-end 数量
                th.text-end 金額
            tbody
              - @order.order_items.each do |item|
                tr
                  td = item.product.name
                  td.text-end = number_to_currency(item.unit_price, unit: '¥', precision: 0)
                  td.text-end = item.quantity
                  td.text-end = number_to_currency(item.amount, unit: '¥', precision: 0)
            tfoot
              tr
                td.text-end colspan="3" 合計
                td.text-end = number_to_currency(@order.total_amount, unit: '¥', precision: 0)

      / 納品情報
      .card.shadow.mb-4
        .card-header.py-3
          h6.m-0.font-weight-bold.text-primary
            i.bi.bi-truck.me-2
            | 納品情報
        .card-body
          .row.mb-3
            .col-md-6
              label.form-label 納品日
              p.form-control-plaintext = @order.delivery_date&.strftime('%Y年%m月%d日') || '未設定'
            .col-md-6
              label.form-label 納品先
              p.form-control-plaintext = @order.delivery_address.presence || '未設定'

      / 履歴
      .card.shadow.mb-4
        .card-header.py-3
          h6.m-0.font-weight-bold.text-primary
            i.bi.bi-clock-history.me-2
            | 処理履歴
        .card-body
          .timeline
            - @order.histories.order(created_at: :desc).each do |history|
              .timeline-item.mb-3
                .timeline-marker
                .timeline-content
                  .d-flex.justify-content-between
                    strong = history.description
                    small.text-muted = history.created_at.strftime('%Y/%m/%d %H:%M')

    .col-lg-4
      / 操作ボタン
      .card.shadow.mb-4
        .card-header.py-3
          h6.m-0.font-weight-bold.text-primary
            i.bi.bi-gear.me-2
            | 操作
        .card-body
          .d-grid.gap-2
            = link_to order_path(@order), \
                data: { delete_action: true, confirm: "この案件を削除してもよろしいですか？\nこの操作は取り消せません。" }, \
                class: "btn btn-outline-danger" do
              i.bi.bi-trash.me-1
              | 削除

= javascript_include_tag "delete_actions"