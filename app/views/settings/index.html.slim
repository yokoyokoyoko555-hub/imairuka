.container-fluid
  .row.mb-4
    .col
      h1.h3.mb-3.text-gray-800
        i.bi.bi-gear.me-2
        | 設定

  .row
    .col-md-3
      .list-group.mb-4
        = link_to settings_path(tab: "company"), class: "list-group-item list-group-item-action #{params[:tab].blank? || params[:tab] == 'company' ? 'active' : ''}" do
          i.bi.bi-building.me-2
          | 会社情報
        = link_to settings_path(tab: "status"), class: "list-group-item list-group-item-action #{params[:tab] == 'status' ? 'active' : ''}" do
          i.bi.bi-tag.me-2
          | ステータス設定
        = link_to settings_path(tab: "stripe"), class: "list-group-item list-group-item-action #{params[:tab] == 'stripe' ? 'active' : ''}" do
          i.bi.bi-credit-card.me-2
          | Stripe連携
        = link_to settings_path(tab: "ai"), class: "list-group-item list-group-item-action #{params[:tab] == 'ai' ? 'active' : ''}" do
          i.bi.bi-cpu.me-2
          | AI設定

    .col-md-9
      - if params[:tab].blank? || params[:tab] == "company"
        = form_with model: @company, url: settings_path(tab: "company"), method: :patch, class: "needs-validation", novalidate: true do |f|
          = render "shared/error_messages", model: @company
          .card.shadow.mb-4
            .card-header.py-3
              h6.m-0.font-weight-bold.text-primary
                i.bi.bi-info-circle.me-2
                | 会社情報
            .card-body
              .row.mb-3
                .col-md-6
                  = f.label :name, "会社名", class: "form-label required"
                  = f.text_field :name, class: "form-control", required: true, maxlength: 100
                .col-md-6
                  = f.label :invoice_number, "インボイス登録番号", class: "form-label required"
                  = f.text_field :invoice_number, class: "form-control", required: true, placeholder: "T1234567890123", maxlength: 20
              .row.mb-3
                .col-md-6
                  = f.label :postal_code, "郵便番号", class: "form-label required"
                  = f.text_field :postal_code, class: "form-control", required: true, placeholder: "1234567", maxlength: 7
                .col-md-6
                  = f.label :address, "住所", class: "form-label required"
                  = f.text_field :address, class: "form-control", required: true, maxlength: 500
              .row.mb-3
                .col-md-6
                  = f.label :phone, "電話番号", class: "form-label required"
                  = f.telephone_field :phone, class: "form-control", required: true, placeholder: "0312345678", maxlength: 15
                .col-md-6
                  = f.label :email, "メールアドレス", class: "form-label required"
                  = f.email_field :email, class: "form-control", required: true, maxlength: 100
              .row.mb-3
                .col-md-6
                  = f.label :representative, "代表者名", class: "form-label required"
                  = f.text_field :representative, class: "form-control", required: true, maxlength: 50
                .col-md-6
                  = f.label :business_type, "業種", class: "form-label required"
                  = f.text_field :business_type, class: "form-control", required: true, maxlength: 50
              .text-end
                = f.submit "設定を保存", class: "btn btn-primary", data: { disable_with: "保存中..." }

      - if params[:tab] == "status"
        .card.shadow.mb-4
          .card-header.py-3.d-flex.justify-content-between.align-items-center
            h6.m-0.font-weight-bold.text-primary
              i.bi.bi-tag.me-2
              | ステータス設定
            = link_to new_order_status_path, class: "btn btn-primary btn-sm" do
              i.bi.bi-plus.me-1
              | ステータス登録
          .card-body
            table.table.table-bordered.table-hover
              thead.table-light
                tr
                  th ステータス名
                  th コード
                  th 表示順
                  th 色
                  th 状態
                  th
              tbody
                - @order_statuses&.each do |status|
                  tr
                    td = status.name
                    td = status.code
                    td = status.display_order
                    td
                      span.badge style="background-color: #{status.color}"
                        = status.color
                    td
                      - if status.is_active
                        span.badge.bg-success 有効
                      - else
                        span.badge.bg-secondary 無効
                    td.text-end
                      = link_to edit_order_status_path(status), class: "btn btn-sm btn-outline-primary me-1" do
                        i.bi.bi-pencil
                      = link_to order_status_path(status), class: "btn btn-sm btn-outline-danger", data: { delete_action: true, confirm: "このステータスを削除しますか？" } do
                        i.bi.bi-trash.me-1
                        | 削除

      - if params[:tab] == "stripe"
        .card.shadow.mb-4
          .card-header.py-3
            h6.m-0.font-weight-bold.text-primary
              i.bi.bi-credit-card.me-2
              | Stripe連携
          .card-body
            .row.mb-4
              .col-md-6
                label.form-label 決済モード
                p.form-control-plaintext
                  span.badge.bg-info.text-dark = StripeSettings.mode_label
              .col-md-6
                label.form-label Stripeキー
                p.form-control-plaintext
                  - if StripeSettings.configured?
                    span.badge.bg-success 設定済み
                  - else
                    span.badge.bg-secondary 未設定
            .row.mb-4
              .col-md-6
                label.form-label 連携状態
                p.form-control-plaintext
                  - if StripeSettings.direct_mode? && StripeSettings.configured?
                    span.badge.bg-success 利用可能
                  - elsif StripeSettings.direct_mode?
                    span.badge.bg-secondary 未設定
                  - elsif @company.stripe_connected?
                    span.badge.bg-success = @company.stripe_connect_status
                  - elsif @company.stripe_account_id.present?
                    span.badge.bg-warning.text-dark = @company.stripe_connect_status
                  - else
                    span.badge.bg-secondary = @company.stripe_connect_status
              .col-md-6
                label.form-label StripeアカウントID
                p.form-control-plaintext = StripeSettings.direct_mode? ? "直接決済モード" : (@company.stripe_account_id.presence || "未連携")
            - if StripeSettings.direct_mode?
              .alert class=(StripeSettings.configured? ? "alert-success" : "alert-warning")
                i.bi.bi-info-circle.me-2
                = StripeSettings.configured? ? "直接決済モードで利用できます。" : "STRIPE_SECRET_KEY と STRIPE_WEBHOOK_SECRET を設定してください。"
            - elsif ENV["STRIPE_SECRET_KEY"].blank?
              .alert.alert-warning
                i.bi.bi-exclamation-triangle.me-2
                | 運営側 Stripe Connect 用キーが未設定です。
            - else
              = button_to stripe_connect_path, method: :post, class: "btn btn-primary", form: { data: { turbo: false } } do
                i.bi.bi-box-arrow-up-right.me-2
                = @company.stripe_account_id.present? ? "Stripe設定を再開" : "Stripeと連携"

      - if params[:tab] == "ai"
        = form_with model: @company, url: settings_path(tab: "ai"), method: :patch, local: true do |f|
          = render "shared/error_messages", model: @company
          .card.shadow.mb-4
            .card-header.py-3
              h6.m-0.font-weight-bold.text-primary
                i.bi.bi-cpu.me-2
                | AI設定
            .card-body
              .alert.alert-info
                i.bi.bi-info-circle.me-2
                | この設定は各社ごとに保存されます。案件概要からガントチャート下書きを作成するとき、この会社のAPIキーを使用します。
              .row.mb-3
                .col-md-6
                  = f.label :ai_provider, "AIプロバイダー", class: "form-label"
                  = f.select :ai_provider, Company::AI_PROVIDERS.map { |value, label| [label, value] }, {}, class: "form-select"
                  .form-text 対応AI: OpenAI / Claude / Gemini / Copilot
                .col-md-6
                  = f.label :ai_model, "モデル", class: "form-label"
                  = f.text_field :ai_model, class: "form-control", placeholder: @company.ai_model_or_default
                  .form-text 例: gpt-5、claude-sonnet-4-5、gemini-2.5-pro など
              .mb-3
                label.form-label APIキー状態
                p.form-control-plaintext
                  - if @company.ai_configured?
                    span.badge.bg-success 設定済み
                  - else
                    span.badge.bg-secondary 未設定
              .mb-3
                = f.label :ai_api_key, "APIキー", class: "form-label"
                = f.password_field :ai_api_key, class: "form-control", autocomplete: "new-password", placeholder: @company.ai_configured? ? "変更する場合のみ入力" : "選択したAIのAPIキー"
                .form-text APIキーは暗号化して保存します。画面上に再表示されません。
              .alert.alert-light.border
                .small.mb-1
                  strong Copilotについて
                .small.text-muted Copilotは利用形態によってAPI仕様が異なるため、Microsoft側の接続方式が確定してから実決済環境で有効化します。現時点のAI下書き生成はOpenAI / Claude / Geminiが対象です。
              - if @company.ai_configured?
                .form-check.mb-3
                  = f.check_box :clear_ai_api_key, class: "form-check-input"
                  = f.label :clear_ai_api_key, "保存済みAPIキーを削除する", class: "form-check-label"
              .text-end
                = f.submit "AI設定を保存", class: "btn btn-primary", data: { disable_with: "保存中..." }

= javascript_include_tag "delete_actions"
