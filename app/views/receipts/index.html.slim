.container-fluid
  .row.mb-4
    .col
      h1.h3.mb-3.text-gray-800
        i.bi.bi-receipt.me-2
        | 領収書管理
      .d-flex.justify-content-end
        = link_to new_receipt_path, class: 'btn btn-primary' do
          i.bi.bi-plus.me-1
          | 新規作成

  / 検索フィルター
  .card.shadow.mb-4
    .card-header.py-3
      h6.m-0.font-weight-bold.text-primary
        i.bi.bi-search.me-2
        | 検索条件
    .card-body
      = search_form_for @q, url: receipts_path, class: "row g-3" do |f|
        .col-md-3
          = f.label :receipt_number_cont, "領収書番号", class: "form-label"
          = f.text_field :receipt_number_cont, class: "form-control"
        .col-md-3
          = f.label :customer_name_cont, "顧客名", class: "form-label"
          = f.text_field :customer_name_cont, class: "form-control"
        .col-md-2
          = f.label :status_eq, "ステータス", class: "form-label"
          = f.select :status_eq, [["全て", ""], ["送付待ち", "pending"], ["送付済み", "sent"], ["入金待ち", "waiting_payment"], ["入金済み", "paid"]], {}, class: "form-select"
        .col-md-2
          = f.label :issue_date_gteq, "発行日（From）", class: "form-label"
          = f.date_field :issue_date_gteq, class: "form-control"
        .col-md-2
          = f.label :issue_date_lteq, "発行日（To）", class: "form-label"
          = f.date_field :issue_date_lteq, class: "form-control"
        .col-12
          = f.submit "検索", class: "btn btn-primary me-2"
          = link_to "リセット", receipts_path, class: "btn btn-outline-secondary"

  / 領収書一覧
  .card.shadow.mb-4
    .card-header.py-3.d-flex.justify-content-between.align-items-center
      h6.m-0.font-weight-bold.text-primary
        i.bi.bi-list.me-2
        | 領収書一覧
        span.badge.bg-secondary.ms-2 = @receipts.total_count

    .card-body
      .table-responsive
        table.table.table-bordered.table-hover
          thead.table-light
            tr
              th 領収書番号
              th 発行日
              th 顧客名
              th 案件名
              th.text-end 金額
              th ステータス
              th 操作
          tbody
            - @receipts.each do |receipt|
              tr
                td = receipt.receipt_number
                td = format_date(receipt.issue_date)
                td = receipt.customer_name
                td = receipt.subject.presence || "-"
                td.text-end = number_to_currency(receipt.total_amount_with_tax, unit: "¥", precision: 0)
                td
                  - if receipt.draft?
                    span.badge.bg-warning style="color: #FFFFFF; text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000;"
                      | 一時保存
                  - else
                    span.badge class="bg-#{receipt_status_color(receipt.status)}" style="color: #FFFFFF; text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000;"
                      = receipt_status_label(receipt.status)
                td
                  .btn-group
                    = link_to receipt_path(receipt), class: 'btn btn-sm btn-outline-primary' do
                      i.bi.bi-eye.me-1
                      | 詳細
                    = link_to edit_receipt_path(receipt), class: 'btn btn-sm btn-outline-secondary' do
                      i.bi.bi-pencil.me-1
                      | 編集
                    = link_to print_receipt_path(receipt), class: 'btn btn-sm btn-outline-info', target: '_blank' do
                      i.bi.bi-printer.me-1
                      | プレビュー
                    = link_to receipt_path(receipt), class: 'btn btn-sm btn-outline-danger', data: { delete_action: true, confirm: 'この領収書を削除してもよろしいですか？\nこの操作は取り消せません。' } do
                      i.bi.bi-trash.me-1
                      | 削除

      / ページネーション
      .d-flex.justify-content-center.mt-4
        = paginate @receipts

= javascript_include_tag "delete_actions" 
