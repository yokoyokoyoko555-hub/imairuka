.card.shadow-sm.signup-card
  .card-header.bg-primary.text-white.text-center.py-3
    h1.h4.mb-0
      i.bi.bi-box-arrow-in-right.me-2
      | Imairuka 利用申込

  .card-body
    .mx-auto style="max-width: 760px;"
      .mb-4
        h2.h5.fw-bold.mb-2 申込内容を確認後、運営より利用開始のご案内をお送りします
        p.text-muted.mb-0
          | 送信された内容は、運営側の契約管理に「申込受付」の契約候補として自動登録されます。SaaS利用料は請求書・銀行振込でのお支払いです。

      = render "shared/error_messages", model: @company

      = form_with model: @company, url: signup_path, local: true do |f|
        .row.g-3
          .col-md-6
            = f.label :name, "会社名", class: "form-label"
            = f.text_field :name, class: "form-control", required: true
          .col-md-6
            = f.label :representative, "代表者名", class: "form-label"
            = f.text_field :representative, class: "form-control", required: true
          .col-md-6
            = f.label :email, "連絡先メールアドレス", class: "form-label"
            = f.email_field :email, class: "form-control", required: true
          .col-md-6
            = f.label :phone, "電話番号", class: "form-label"
            = f.telephone_field :phone, class: "form-control", placeholder: "0312345678", required: true
          .col-md-6
            = f.label :postal_code, "郵便番号", class: "form-label"
            = f.text_field :postal_code, class: "form-control", placeholder: "1000000", required: true
          .col-md-6
            = f.label :invoice_number, "登録番号", class: "form-label"
            = f.text_field :invoice_number, class: "form-control", placeholder: "T1234567890123", required: true
          .col-12
            = f.label :address, "住所", class: "form-label"
            = f.text_area :address, class: "form-control", rows: 2, required: true
          .col-md-6
            = f.label :business_type, "業種", class: "form-label"
            = f.text_field :business_type, class: "form-control", required: true
          .col-md-6
            .border.rounded.p-3.bg-light.h-100
              .fw-bold = Company::PLAN_LABEL
              .text-muted.small
                | 全機能利用可能。標準1名まで、追加アカウントは契約変更で対応します。
              .small.mt-2
                | 契約単位: 利用会社1社 / 2年契約
            = f.hidden_field :plan_name, value: Company::DEFAULT_PLAN_NAME
          .col-12
            = f.label :vendor_code, "ベンダーコード（紹介元がある場合のみ）", class: "form-label"
            = f.text_field :vendor_code, class: "form-control", placeholder: "例: VENDOR-A"
            .form-text 未入力の場合は直販申込として受け付けます。

        .d-flex.justify-content-between.align-items-center.mt-4
          = link_to "ログインへ戻る", login_path, class: "btn btn-outline-secondary"
          = f.submit "申込を送信", class: "btn btn-primary"
